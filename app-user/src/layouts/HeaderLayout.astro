---
import ThemeToggle from '../components/ui/ThemeToggle.astro';
---

<header class="border-b border-zinc-200 bg-zinc-50/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-900 text-xs font-bold tracking-wide text-white dark:bg-teal-500">
        ONPE
      </div>
      <span class="font-display text-xl font-semibold tracking-tight text-zinc-900 dark:text-white">Convocatorias</span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium text-zinc-500 dark:text-zinc-400">
      <a href="/" class="text-zinc-900 dark:text-white">Convocatorias</a>
      <a
        href="https://reclutamiento.onpe.gob.pe"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-zinc-900 dark:hover:text-white"
      >
        Portal SIGLOC
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
