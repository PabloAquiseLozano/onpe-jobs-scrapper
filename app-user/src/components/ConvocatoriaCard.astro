---
import Badge from './ui/Badge.astro';
import { esVigente, type Convocatoria } from '../lib/types';

interface Props {
  convocatoria: Convocatoria;
}
const { convocatoria } = Astro.props;
const vigente = esVigente(convocatoria);

const remuneracion = convocatoria.remuneracion_soles
  ? `S/ ${Number(convocatoria.remuneracion_soles).toLocaleString('es-PE', { minimumFractionDigits: 2 })}`
  : 'No especificada';
const fecha = convocatoria.fecha_publicacion
  ? new Date(convocatoria.fecha_publicacion).toLocaleDateString('es-PE', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    })
  : '';
const rubros = convocatoria.rubros ?? [];

const searchhaystack = [convocatoria.titulo, convocatoria.denominacion, ...rubros]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="relative flex flex-col rounded-2xl border border-zinc-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-teal-200 hover:shadow-lg dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-teal-900"
  data-convocatoria
  data-estado={vigente ? 0 : 1}
  data-search={searchhaystack}
>
  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h3 class="line-clamp-2 text-base font-semibold text-zinc-900 dark:text-white">{convocatoria.titulo}</h3>
        {convocatoria.denominacion && (
          <p class="mt-0.5 truncate text-sm text-zinc-500 dark:text-zinc-400">{convocatoria.denominacion}</p>
        )}
      </div>
      <Badge vigente={vigente} />
    </div>

    {rubros.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {rubros.map((r) => (
          <span class="rounded-full px-2.5 py-0.5 text-xs text-zinc-600 ring-1 ring-inset ring-zinc-300 dark:text-zinc-400 dark:ring-zinc-700">
            {r}
          </span>
        ))}
      </div>
    )}

    <div class="mt-auto flex items-end justify-between gap-3 border-t border-zinc-100 pt-3 dark:border-zinc-800">
      <span class="font-display text-xl font-semibold text-teal-900 dark:text-teal-300">{remuneracion}</span>
      {convocatoria.cantidad_requerida != null && (
        <span class="flex items-center gap-1 text-xs text-zinc-500 dark:text-zinc-400">
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
          </svg>
          {convocatoria.cantidad_requerida} vacante(s)
        </span>
      )}
    </div>

    {fecha && <p class="text-xs text-zinc-400 dark:text-zinc-500">Publicado: {fecha}</p>}
  </div>

  <div class="flex items-center justify-between border-t border-zinc-100 px-5 py-3 text-sm font-medium text-teal-700 dark:border-zinc-800 dark:text-teal-400">
    Ver detalle
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>

  <a href={`/convocatorias/${convocatoria.id_perfil}`} class="absolute inset-0 rounded-2xl">
    <span class="sr-only">Ver detalle de {convocatoria.titulo}</span>
  </a>
</article>
